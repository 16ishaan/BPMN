<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HospitalBooking" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="hospital-booking" name="Hospital Appointment Booking" isExecutable="true">

    <bpmn:startEvent id="StartEvent_Booking" name="Booking requested">
      <bpmn:outgoing>Flow_Start_Check</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="Task_CheckSlot" name="Check slot">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="slot_decision" resultVariable="slotDecision" />
        <zeebe:ioMapping>
          <zeebe:output source="=slotDecision.slotStatus" target="slotStatus" />
          <zeebe:output source="=slotDecision.suggestedAction" target="suggestedAction" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_GW</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_Slot" name="Slot status?">
      <bpmn:incoming>Flow_Check_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Available</bpmn:outgoing>
      <bpmn:outgoing>Flow_Full</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:scriptTask id="Task_BookSlot" name="Book slot">
      <bpmn:extensionElements>
        <zeebe:script expression="=true" resultVariable="slotBooked" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_Book_Confirm</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:callActivity id="Call_Confirm" name="Send confirmation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=patientId" target="recipientId" />
          <zeebe:input source="=&#34;Dear &#34; + patientName + &#34;, your &#34; + department + &#34; appointment is confirmed for &#34; + preferredSlot + &#34;.&#34;" target="messageText" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Book_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Wait</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:userTask id="Task_Appointment" name="Appointment completed">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Confirm_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Done" name="Appointment done">
      <bpmn:incoming>Flow_Wait_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:callActivity id="Call_SlotFull" name="Send slot full message">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=patientId" target="recipientId" />
          <zeebe:input source="=&#34;Dear &#34; + patientName + &#34;, sorry, the &#34; + department + &#34; slot is full. &#34; + suggestedAction + &#34;.&#34;" target="messageText" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Full</bpmn:incoming>
      <bpmn:outgoing>Flow_Full_End</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:endEvent id="End_Full" name="Slot full, patient notified">
      <bpmn:incoming>Flow_Full_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Check" sourceRef="StartEvent_Booking" targetRef="Task_CheckSlot" />
    <bpmn:sequenceFlow id="Flow_Check_GW" sourceRef="Task_CheckSlot" targetRef="Gateway_Slot" />
    <bpmn:sequenceFlow id="Flow_Available" name="AVAILABLE" sourceRef="Gateway_Slot" targetRef="Task_BookSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotStatus = "AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Full" name="FULL" sourceRef="Gateway_Slot" targetRef="Call_SlotFull">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotStatus = "FULL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Book_Confirm" sourceRef="Task_BookSlot" targetRef="Call_Confirm" />
    <bpmn:sequenceFlow id="Flow_Confirm_Wait" sourceRef="Call_Confirm" targetRef="Task_Appointment" />
    <bpmn:sequenceFlow id="Flow_Wait_End" sourceRef="Task_Appointment" targetRef="End_Done" />
    <bpmn:sequenceFlow id="Flow_Full_End" sourceRef="Call_SlotFull" targetRef="End_Full" />

    <bpmn:subProcess id="SubProcess_Cancel" name="Handle cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="Start_Cancel" name="Cancellation received" isInterrupting="true">
        <bpmn:outgoing>Flow_C1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_Cancel" messageRef="Message_Cancel" />
      </bpmn:startEvent>
      <bpmn:scriptTask id="Task_ReleaseSlot" name="Release slot">
        <bpmn:extensionElements>
          <zeebe:script expression="=false" resultVariable="slotBooked" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C1</bpmn:incoming>
        <bpmn:outgoing>Flow_C2</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:callActivity id="Call_Cancel" name="Send cancellation message">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=patientId" target="recipientId" />
            <zeebe:input source="=&#34;Dear &#34; + patientName + &#34;, your &#34; + department + &#34; booking has been cancelled and the slot released.&#34;" target="messageText" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C2</bpmn:incoming>
        <bpmn:outgoing>Flow_C3</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="End_Cancel" name="Booking cancelled">
        <bpmn:incoming>Flow_C3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_C1" sourceRef="Start_Cancel" targetRef="Task_ReleaseSlot" />
      <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_ReleaseSlot" targetRef="Call_Cancel" />
      <bpmn:sequenceFlow id="Flow_C3" sourceRef="Call_Cancel" targetRef="End_Cancel" />
    </bpmn:subProcess>
  </bpmn:process>

  <bpmn:message id="Message_Cancel" name="cancel-booking">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="hospital-booking">
      <bpmndi:BPMNShape id="StartEvent_Booking_di" bpmnElement="StartEvent_Booking">
        <dc:Bounds x="180" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="156" y="225" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckSlot_di" bpmnElement="Task_CheckSlot">
        <dc:Bounds x="270" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Slot_di" bpmnElement="Gateway_Slot" isMarkerVisible="true">
        <dc:Bounds x="425" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="418" y="232" width="64" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BookSlot_di" bpmnElement="Task_BookSlot">
        <dc:Bounds x="540" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Confirm_di" bpmnElement="Call_Confirm" isExpanded="false">
        <dc:Bounds x="690" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Appointment_di" bpmnElement="Task_Appointment">
        <dc:Bounds x="840" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="990" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="966" y="125" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SlotFull_di" bpmnElement="Call_SlotFull" isExpanded="false">
        <dc:Bounds x="540" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Full_di" bpmnElement="End_Full">
        <dc:Bounds x="690" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="668" y="325" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubProcess_Cancel_di" bpmnElement="SubProcess_Cancel" isExpanded="true">
        <dc:Bounds x="270" y="400" width="480" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Cancel_di" bpmnElement="Start_Cancel">
        <dc:Bounds x="300" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="283" y="505" width="70" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReleaseSlot_di" bpmnElement="Task_ReleaseSlot">
        <dc:Bounds x="380" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Cancel_di" bpmnElement="Call_Cancel" isExpanded="false">
        <dc:Bounds x="530" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancel_di" bpmnElement="End_Cancel">
        <dc:Bounds x="690" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="667" y="505" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Check_di" bpmnElement="Flow_Start_Check">
        <di:waypoint x="216" y="200" /><di:waypoint x="270" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_GW_di" bpmnElement="Flow_Check_GW">
        <di:waypoint x="370" y="200" /><di:waypoint x="425" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Available_di" bpmnElement="Flow_Available">
        <di:waypoint x="450" y="175" /><di:waypoint x="450" y="100" /><di:waypoint x="540" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="458" y="130" width="55" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Full_di" bpmnElement="Flow_Full">
        <di:waypoint x="450" y="225" /><di:waypoint x="450" y="300" /><di:waypoint x="540" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="458" y="260" width="28" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Book_Confirm_di" bpmnElement="Flow_Book_Confirm">
        <di:waypoint x="640" y="100" /><di:waypoint x="690" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Confirm_Wait_di" bpmnElement="Flow_Confirm_Wait">
        <di:waypoint x="790" y="100" /><di:waypoint x="840" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Wait_End_di" bpmnElement="Flow_Wait_End">
        <di:waypoint x="940" y="100" /><di:waypoint x="990" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Full_End_di" bpmnElement="Flow_Full_End">
        <di:waypoint x="640" y="300" /><di:waypoint x="690" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C1_di" bpmnElement="Flow_C1">
        <di:waypoint x="336" y="480" /><di:waypoint x="380" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C2_di" bpmnElement="Flow_C2">
        <di:waypoint x="480" y="480" /><di:waypoint x="530" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C3_di" bpmnElement="Flow_C3">
        <di:waypoint x="630" y="480" /><di:waypoint x="690" y="480" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

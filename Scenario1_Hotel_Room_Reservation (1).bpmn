<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_HotelReservation"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_HotelReservation" name="Hotel Room Reservation Process" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Guest Submits Booking Request">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckAvail" name="Check Room Availability">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Avail" name="Rooms Available?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyNoRooms" name="Notify Guest: No Rooms Available">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_NoRooms" name="Process Ends (No Rooms Available)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_RequestPayment" name="Request Payment (Advance / Deposit)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Payment" name="Payment Successful?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyPaymentFail" name="Notify Guest: Payment Failed">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_PaymentFail" name="Process Ends (Payment Failed)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ConfirmBooking" name="Confirm Booking &amp; Generate Reference Number">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendEmail" name="Send Booking Confirmation Email">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Success" name="Process Ends (Booking Confirmed)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_CheckAvail" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckAvail" targetRef="GW_Avail" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_Avail" targetRef="Task_NotifyNoRooms" name="No" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_NotifyNoRooms" targetRef="End_NoRooms" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="GW_Avail" targetRef="Task_RequestPayment" name="Yes" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RequestPayment" targetRef="GW_Payment" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="GW_Payment" targetRef="Task_NotifyPaymentFail" name="Failed" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_NotifyPaymentFail" targetRef="End_PaymentFail" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="GW_Payment" targetRef="Task_ConfirmBooking" name="Successful" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ConfirmBooking" targetRef="Task_SendEmail" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SendEmail" targetRef="End_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_HotelReservation">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="60" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckAvail_di" bpmnElement="Task_CheckAvail">
        <dc:Bounds x="150" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Avail_di" bpmnElement="GW_Avail">
        <dc:Bounds x="310" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyNoRooms_di" bpmnElement="Task_NotifyNoRooms">
        <dc:Bounds x="410" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NoRooms_di" bpmnElement="End_NoRooms">
        <dc:Bounds x="570" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestPayment_di" bpmnElement="Task_RequestPayment">
        <dc:Bounds x="420" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Payment_di" bpmnElement="GW_Payment">
        <dc:Bounds x="580" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyPaymentFail_di" bpmnElement="Task_NotifyPaymentFail">
        <dc:Bounds x="680" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PaymentFail_di" bpmnElement="End_PaymentFail">
        <dc:Bounds x="840" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmBooking_di" bpmnElement="Task_ConfirmBooking">
        <dc:Bounds x="690" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendEmail_di" bpmnElement="Task_SendEmail">
        <dc:Bounds x="850" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Success_di" bpmnElement="End_Success">
        <dc:Bounds x="1010" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="78" y="218" />
        <di:waypoint x="78" y="200" />
        <di:waypoint x="150" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="200" y="240" />
        <di:waypoint x="200" y="200" />
        <di:waypoint x="310" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="335" y="225" />
        <di:waypoint x="335" y="370" />
        <di:waypoint x="410" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="355" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="460" y="410" />
        <di:waypoint x="460" y="370" />
        <di:waypoint x="570" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="335" y="225" />
        <di:waypoint x="335" y="200" />
        <di:waypoint x="420" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="185" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="470" y="240" />
        <di:waypoint x="470" y="200" />
        <di:waypoint x="580" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="605" y="225" />
        <di:waypoint x="605" y="370" />
        <di:waypoint x="680" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="355" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="730" y="410" />
        <di:waypoint x="730" y="370" />
        <di:waypoint x="840" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="605" y="225" />
        <di:waypoint x="605" y="200" />
        <di:waypoint x="690" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="185" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="790" y="200" />
        <di:waypoint x="850" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="900" y="240" />
        <di:waypoint x="900" y="200" />
        <di:waypoint x="1010" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

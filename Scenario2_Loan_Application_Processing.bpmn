        <di:waypoint x="700" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="585" y="185" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="750" y="240" />
        <di:waypoint x="750" y="200" />

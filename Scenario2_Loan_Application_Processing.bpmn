<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_LoanApplication"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_LoanApplication" name="Loan Application Processing" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Customer Submits Loan Application">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Verify" name="Verify Documents &amp; Credit Score">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_DocsValid" name="Documents Valid?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RejectDocs" name="Reject Application &amp; Notify Customer">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_RejectDocs" name="Process Ends (Application Rejected)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CheckEligibility" name="Check Eligibility (Credit Score &amp; Income)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Eligible" name="Eligible?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RejectNotEligible" name="Send Rejection Notification to Customer">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_RejectNotEligible" name="Process Ends (Not Eligible)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Forward" name="Forward Request to Loan Officer">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_OfficerApproves" name="Loan Officer Approves?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RejectOfficer" name="Send Rejection Notification to Customer">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_RejectOfficer" name="Process Ends (Loan Rejected)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Disburse" name="Disburse Loan Amount">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendApproval" name="Send Approval Notification">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Approved" name="Process Ends (Loan Approved)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Verify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Verify" targetRef="GW_DocsValid" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_DocsValid" targetRef="Task_RejectDocs" name="Invalid" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_RejectDocs" targetRef="End_RejectDocs" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="GW_DocsValid" targetRef="Task_CheckEligibility" name="Valid" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CheckEligibility" targetRef="GW_Eligible" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="GW_Eligible" targetRef="Task_RejectNotEligible" name="Not Eligible" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_RejectNotEligible" targetRef="End_RejectNotEligible" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="GW_Eligible" targetRef="Task_Forward" name="Eligible" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Forward" targetRef="GW_OfficerApproves" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="GW_OfficerApproves" targetRef="Task_RejectOfficer" name="Rejects" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RejectOfficer" targetRef="End_RejectOfficer" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="GW_OfficerApproves" targetRef="Task_Disburse" name="Approves" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Disburse" targetRef="Task_SendApproval" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SendApproval" targetRef="End_Approved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LoanApplication">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="60" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_di" bpmnElement="Task_Verify">
        <dc:Bounds x="150" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_DocsValid_di" bpmnElement="GW_DocsValid">
        <dc:Bounds x="310" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectDocs_di" bpmnElement="Task_RejectDocs">
        <dc:Bounds x="410" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectDocs_di" bpmnElement="End_RejectDocs">
        <dc:Bounds x="570" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckEligibility_di" bpmnElement="Task_CheckEligibility">
        <dc:Bounds x="420" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Eligible_di" bpmnElement="GW_Eligible">
        <dc:Bounds x="590" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectNotEligible_di" bpmnElement="Task_RejectNotEligible">
        <dc:Bounds x="690" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectNotEligible_di" bpmnElement="End_RejectNotEligible">
        <dc:Bounds x="850" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Forward_di" bpmnElement="Task_Forward">
        <dc:Bounds x="700" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_OfficerApproves_di" bpmnElement="GW_OfficerApproves">
        <dc:Bounds x="870" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectOfficer_di" bpmnElement="Task_RejectOfficer">
        <dc:Bounds x="970" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectOfficer_di" bpmnElement="End_RejectOfficer">
        <dc:Bounds x="1130" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Disburse_di" bpmnElement="Task_Disburse">
        <dc:Bounds x="980" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendApproval_di" bpmnElement="Task_SendApproval">
        <dc:Bounds x="1140" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved">
        <dc:Bounds x="1300" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="78" y="218" />
        <di:waypoint x="78" y="200" />
        <di:waypoint x="150" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="200" y="240" />
        <di:waypoint x="200" y="200" />
        <di:waypoint x="310" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="335" y="225" />
        <di:waypoint x="335" y="370" />
        <di:waypoint x="410" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="355" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="460" y="410" />
        <di:waypoint x="460" y="370" />
        <di:waypoint x="570" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="335" y="225" />

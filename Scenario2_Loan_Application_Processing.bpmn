        <di:waypoint x="970" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="865" y="355" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1020" y="410" />
        <di:waypoint x="1020" y="370" />
        <di:waypoint x="1130" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="895" y="225" />
        <di:waypoint x="895" y="200" />
        <di:waypoint x="980" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="865" y="185" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1080" y="200" />
        <di:waypoint x="1140" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1190" y="240" />
        <di:waypoint x="1190" y="200" />
        <di:waypoint x="1300" y="200" />

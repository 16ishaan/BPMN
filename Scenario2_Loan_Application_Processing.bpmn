        <di:waypoint x="690" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="585" y="355" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="740" y="410" />
        <di:waypoint x="740" y="370" />

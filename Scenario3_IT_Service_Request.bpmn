<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ITRequest"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_ITServiceRequest" name="IT Service Request" isExecutable="false">

    <bpmn:startEvent id="StartEvent_1" name="Employee reports IT problem">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SubmitRequest" name="Submit IT Support Request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RegisterRequest" name="Register Request">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckSeverity" name="Check Severity of Problem">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Severity" name="Severity?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Low</bpmn:outgoing>
      <bpmn:outgoing>Flow_High</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_AssignSupportTech" name="Assign to Support Technician">
      <bpmn:incoming>Flow_Low</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AssignSeniorTech" name="Assign to Senior Technician">
      <bpmn:incoming>Flow_High</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MergeAssign" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Investigate" name="Investigate the Problem">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Resolvable" name="Can Be Resolved?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_FixProblem" name="Fix the Problem">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EscalateExternal" name="Escalate to External Service Provider">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MergeResolution" name="">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_UpdateStatus" name="Update Request Status">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendResolutionNotification" name="Send Resolution Notification">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Employee receives resolution notification">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_RegisterRequest" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_RegisterRequest" targetRef="Task_CheckSeverity" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckSeverity" targetRef="Gateway_Severity" />
    <bpmn:sequenceFlow id="Flow_Low" name="Low Severity" sourceRef="Gateway_Severity" targetRef="Task_AssignSupportTech" />
    <bpmn:sequenceFlow id="Flow_High" name="High Severity" sourceRef="Gateway_Severity" targetRef="Task_AssignSeniorTech" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_AssignSupportTech" targetRef="Gateway_MergeAssign" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AssignSeniorTech" targetRef="Gateway_MergeAssign" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_MergeAssign" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Investigate" targetRef="Gateway_Resolvable" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Resolvable" sourceRef="Gateway_Resolvable" targetRef="Task_FixProblem" />
    <bpmn:sequenceFlow id="Flow_No" name="Not Resolvable" sourceRef="Gateway_Resolvable" targetRef="Task_EscalateExternal" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_FixProblem" targetRef="Gateway_MergeResolution" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_EscalateExternal" targetRef="Gateway_MergeResolution" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_MergeResolution" targetRef="Task_UpdateStatus" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_UpdateStatus" targetRef="Task_SendResolutionNotification" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SendResolutionNotification" targetRef="EndEvent_1" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ITServiceRequest">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="100" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest">
        <dc:Bounds x="180" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RegisterRequest_di" bpmnElement="Task_RegisterRequest">
        <dc:Bounds x="330" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckSeverity_di" bpmnElement="Task_CheckSeverity">
        <dc:Bounds x="480" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Severity_di" bpmnElement="Gateway_Severity" isMarkerVisible="true">
        <dc:Bounds x="630" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AssignSupportTech_di" bpmnElement="Task_AssignSupportTech">
        <dc:Bounds x="730" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AssignSeniorTech_di" bpmnElement="Task_AssignSeniorTech">
        <dc:Bounds x="730" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergeAssign_di" bpmnElement="Gateway_MergeAssign" isMarkerVisible="true">
        <dc:Bounds x="880" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Investigate_di" bpmnElement="Task_Investigate">
        <dc:Bounds x="980" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Resolvable_di" bpmnElement="Gateway_Resolvable" isMarkerVisible="true">
        <dc:Bounds x="1130" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FixProblem_di" bpmnElement="Task_FixProblem">
        <dc:Bounds x="1230" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_EscalateExternal_di" bpmnElement="Task_EscalateExternal">
        <dc:Bounds x="1230" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergeResolution_di" bpmnElement="Gateway_MergeResolution" isMarkerVisible="true">
        <dc:Bounds x="1380" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_UpdateStatus_di" bpmnElement="Task_UpdateStatus">
        <dc:Bounds x="1480" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendResolutionNotification_di" bpmnElement="Task_SendResolutionNotification">
        <dc:Bounds x="1630" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1780" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="136" y="200" />
        <di:waypoint x="180" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="280" y="200" />
        <di:waypoint x="330" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="430" y="200" />
        <di:waypoint x="480" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="580" y="200" />
        <di:waypoint x="630" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Low_di" bpmnElement="Flow_Low">
        <di:waypoint x="655" y="175" />
        <di:waypoint x="655" y="80" />
        <di:waypoint x="730" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_High_di" bpmnElement="Flow_High">
        <di:waypoint x="655" y="225" />
        <di:waypoint x="655" y="360" />
        <di:waypoint x="730" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="830" y="80" />
        <di:waypoint x="905" y="80" />
        <di:waypoint x="905" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="830" y="360" />
        <di:waypoint x="905" y="360" />
        <di:waypoint x="905" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="930" y="200" />
        <di:waypoint x="980" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1080" y="200" />
        <di:waypoint x="1130" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="1155" y="175" />
        <di:waypoint x="1155" y="80" />
        <di:waypoint x="1230" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="1155" y="225" />
        <di:waypoint x="1155" y="360" />
        <di:waypoint x="1230" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1330" y="80" />
        <di:waypoint x="1405" y="80" />
        <di:waypoint x="1405" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1330" y="360" />
        <di:waypoint x="1405" y="360" />
        <di:waypoint x="1405" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1430" y="200" />
        <di:waypoint x="1480" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1580" y="200" />
        <di:waypoint x="1630" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1730" y="200" />
        <di:waypoint x="1780" y="200" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
